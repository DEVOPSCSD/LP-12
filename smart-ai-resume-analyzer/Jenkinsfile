
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Getting AI Resume Analyzer source code'
                checkout scm
            }
        }

        stage('Check Project Files') {
            steps {
                sh '''
                    test -f app.py
                    echo "Application file found"
                    test -d templates
                    echo "Templates folder found"
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python3 --version
                    if [ -f requirements.txt ]; then
                        python3 -m pip install -r requirements.txt
                    else
                        echo "requirements.txt not found"
                        exit 1
                    fi
                '''
            }
        }

        stage('Validate Python') {
            steps {
                sh 'python3 -m compileall -q app.py'
                echo 'Python syntax validation successful'
            }
        }
    }

    post {
        success {
            echo 'AI Resume Analyzer CI pipeline completed!'
        }
        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}
